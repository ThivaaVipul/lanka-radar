<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget's colours before Android 12: the app's own (AppTheme,
     light). From Android 12 they come from the wallpaper (values-v31). -->
<resources>
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_on_surface">#191C1C</color>
    <color name="widget_muted">#5D6564</color>
    <!-- A rise and a fall, as tertiary and primary in the app. -->
    <color name="widget_rise">#9A5B13</color>
    <color name="widget_fall">#0F766E</color>
    <color name="widget_cut">#F6E4CC</color>
    <color name="widget_on_cut">#3B2306</color>
</resources>

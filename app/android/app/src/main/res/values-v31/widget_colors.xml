<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's colours from Android 12: the wallpaper's palette (Material
     You). A rise takes the third accent and a fall the main one, the roles of
     ochre and teal in the app. -->
<resources>
    <color name="widget_surface">@android:color/system_accent2_50</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_muted">@android:color/system_neutral2_700</color>
    <color name="widget_rise">@android:color/system_accent3_600</color>
    <color name="widget_fall">@android:color/system_accent1_600</color>
    <color name="widget_cut">@android:color/system_accent3_100</color>
    <color name="widget_on_cut">@android:color/system_accent3_900</color>
</resources>

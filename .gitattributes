# Normalize to LF in the repo and working tree, Windows included.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Saved source responses stay byte for byte as the sources sent them.
scrapers/tests/fixtures/** -text

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ttf binary
*.otf binary
*.jar binary
*.jks binary
*.keystore binary
